# Fallpit Core: environment variable names. Copy to .env and fill in; never commit .env.
# Values are read by `forge script script/DeployTestnet.s.sol` and by the fork tests.

# --- deploy (script/DeployTestnet.s.sol)
# Required. Pays for the deployment and runs the setup.
DEPLOYER_PRIVATE_KEY=
# Optional. Owner of the oracle, chip guard, book and treasury (default: the deployer).
OWNER=
# Optional. May dispute a keeper close in its challenge window, in force 24 hours after the deploy
# (default: OWNER). It cannot void anything.
GUARDIAN=
# the keeper's sender address: may set the learned sigma of open rounds (house vol learning); empty = off
VOL_KEEPER=
# Optional. Receives the protocol's fee share (default: OWNER).
FEE_RECIPIENT=
# Optional. Comma-separated keeper signer addresses (default: none).
KEEPER_SIGNERS=
# Optional. Signatures a keeper print needs (default: a strict majority of KEEPER_SIGNERS).
KEEPER_THRESHOLD=
# Optional. Seconds before a ticker registration, a reseed, a guardian or new defaults take effect
# (default 86400 = 24 hours, the mainnet value). A testnet sets 0, so its tickers are in force at once and
# the houses can be created in the same run.
OWNER_DELAY=
# Optional. Seconds before a signer set or threshold change takes effect (default 86400 = 24 hours).
SIGNER_DELAY=
# Optional. Address that copies mainnet Chainlink rounds into the MirrorFeeds (default: the deployer). It
# must not be one of KEEPER_SIGNERS (the script refuses): on testnet it decides the keeper bound.
MIRROR_PUSHER=
# Optional. Comma-separated tickers out of TSLA,NVDA,AAPL,GME,MSTR,QQQ,ETH,BTC (default: the six stocks and
# ETH). The stocks run on the New York weekday clock, ETH and BTC on the every-day clock.
TICKERS=
# Optional. true drops the Pyth feed id of every KeeperOnly ticker, as the mainnet launch does, so the
# keeper's print records its close (a ticker with a feed id closes on Pyth only). The testnet run sets true.
KEEPER_CLOSES=
# Optional. Comma-separated FaucetCoin names and symbols (defaults: "Pit Rat,Siren" and "RAT,SIREN").
CHIP_NAMES=
CHIP_SYMBOLS=
# Optional. Whole coins minted once to the deployer per chip (default 10000000).
CHIP_SUPPLY=
# Second run only (createHouses()): the PitVault and the chips of the first run, the pairs to create, and
# the whole coins the deployer deposits into each house (default 100000, 0 for none). HOUSES is a
# comma-separated list of TICKER:CHIPSYMBOL, for example GME:RAT,GME:SIREN,ETH:PIT. With it unset the run
# falls back to one house per (TICKERS, CHIPS) pair, the full matrix: a house cannot be removed, so list
# the pairs you mean.
VAULT=
CHIPS=
HOUSES=
SEED_PER_HOUSE=
# Optional. Override the Robinhood Chain addresses.
POOL_MANAGER=
PYTH=
# Not set here: the round parameters are the PitBook's built-in defaults (fill fee 0.000025 ETH paid by the
# trader with every commit, loss limit 30% of a round's capital, per-fill cap 2%, no product cap), and the
# keeper band (60 bps) and the close lag (300 s) are the PitOracle's defaults. The owner changes them on
# chain, inside the contracts' bounds.

# --- mainnet (script/DeployMainnet.s.sol, 4663). No key here: pass --interactive --sender <deployer>.
# Required. Every role is checked: none may be zero, and no keeper signer may be the deployer or OWNER.
# OWNER is the deployer at launch (nothing is handed over); a multisig later.
OWNER=
GUARDIAN=
FEE_RECIPIENT=
KEEPER_SIGNERS=
# Optional. Offer the book to an OWNER that is not the deployer in run() (default true). Set false for the
# second run.
HANDOVER=
# Optional. The least seed of a public listing, in whole USD (50 to 5,000; default 50).
MIN_SEED_USD=
# Optional. Comma-separated tickers out of the script's table (default: the whole table).
TICKERS=
# Second run, 24 hours later (createHouses()): the PitLister of the first run and TICKER:COIN pairs.
LISTER=
HOUSES=
# Optional. Where run() writes and handOver() reads the record (default deployments/4663.json).
DEPLOYMENTS_FILE=
# Optional. The fill fee script/CheckDeployment.s.sol expects, in wei (default 25000000000000 = 0.000025 ETH).
FILL_FEE=

# --- RPC endpoints
RPC_46630=
RPC_4663=
# --- fork tests (skipped when unset)
FORK_RPC_46630=
FORK_RPC_4663=
